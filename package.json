{
  "name": "controle-emprestimos-nubank",
  "version": "1.0.0",
  "type": "module",
  "description": "App Desktop Portable de Controle de Empréstimos e Simulador Financeiro com Regras Nubank",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "web": "vite --open",
    "preview": "vite preview --open",
    "build": "tsc && vite build",
    "build:html": "tsc && vite build --config vite.singlefile.config.ts",
    "start": "npm run build && electron .",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.financeiro.emprestimos.nubank",
    "productName": "Controle Financeiro Nubank",
    "electronVersion": "34.2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ControleFinanceiro-Nubank-Portable.exe"
    }
  },
  "keywords": [
    "financeiro",
    "emprestimos",
    "simulador",
    "nubank",
    "electron",
    "portable"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
